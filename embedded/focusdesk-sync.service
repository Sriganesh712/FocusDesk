[Unit]
Description=FocusDesk Two-Way Cloud Sync Daemon for STM32MP135F-DK
After=network.target

[Service]
Type=simple
User=weston
Group=weston
ExecStart=/usr/bin/python3 /home/weston/focusdesk/sync_daemon.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]

Description=Wi-Fi Failover Watchdog

After=NetworkManager.service

Wants=NetworkManager.service



[Service]

Type=simple

ExecStart=/usr/local/bin/wifi-watchdog.sh

Restart=always

RestartSec=5



[Install]

WantedBy=multi-user.target

